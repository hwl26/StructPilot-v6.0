# Streamlit Community Cloud Secrets 示例
# 在 App settings -> Secrets 中粘贴并替换占位值。
# 这里只能提交变量名和占位符；真实密钥不得提交到 Git。
# 根级 Secrets 会作为环境变量提供给当前应用，与代码中的 os.getenv 读取方式一致。

STRUCTPILOT_LLM_PROVIDER = "openai_compatible"
STRUCTPILOT_LLM_API_KEY = "replace-with-your-private-api-key"
STRUCTPILOT_LLM_MODEL = "Qwen/Qwen3-VL-32B-Instruct"
STRUCTPILOT_LLM_BASE_URL = "https://api.siliconflow.cn/v1"
STRUCTPILOT_LLM_TIMEOUT = "30"

STRUCTPILOT_EMBEDDING_MODEL = "BAAI/bge-m3"
STRUCTPILOT_EMBEDDING_BASE_URL = "https://api.siliconflow.cn/v1"
STRUCTPILOT_EMBEDDING_API_KEY = "replace-with-your-private-embedding-key"

STRUCTPILOT_AUDIO_MODEL = "FunAudioLLM/SenseVoiceSmall"
STRUCTPILOT_AUDIO_BASE_URL = "https://api.siliconflow.cn/v1"
STRUCTPILOT_AUDIO_API_KEY = "replace-with-your-private-audio-key"

# 仅当需要启用管理员账号时设置；公开访客体验可不配置。
# 请使用独立且足够长的随机密码，不要复用 API Key 或 GitHub 密码。
# STRUCTPILOT_BOOTSTRAP_ADMIN_PASSWORD = "replace-with-a-long-random-password"

# 如需使用自建 OpenAI-compatible 服务，可显式增加允许的 HTTPS 主机名。
# 不要填写 URL、路径或通配符；多个主机名用英文逗号分隔。
# STRUCTPILOT_ALLOWED_LLM_HOSTS = "api.example.org"
